---
import { getCollection } from 'astro:content';
import icon from '../assets/brand/jusiai-icon-8bit-512.png';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const latestPosts = (await getCollection('devlog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

// 배너의 픽셀 별. [x, y, 색, 십자 여부] — 좌표는 160×90칸 기준
const STARS: [number, number, 'cream' | 'gold' | 'coral', boolean][] = [
	[18, 6, 'cream', false],
	[7, 17, 'gold', false],
	[45, 13, 'coral', false],
	[61, 17, 'coral', true],
	[79, 9, 'cream', true],
	[73, 18, 'gold', false],
	[99, 7, 'cream', true],
	[108, 6, 'coral', false],
	[102, 21, 'coral', false],
	[121, 14, 'cream', false],
	[131, 5, 'coral', false],
	[142, 15, 'coral', false],
	[156, 13, 'coral', true],
	[146, 26, 'cream', false],
	[10, 32, 'cream', false],
	[4, 53, 'gold', false],
	[141, 47, 'cream', true],
	[152, 48, 'gold', false],
	[26, 66, 'gold', false],
	[42, 72, 'coral', true],
	[65, 68, 'cream', false],
	[91, 70, 'gold', true],
	[106, 70, 'cream', true],
	[116, 73, 'cream', true],
	[126, 66, 'gold', false],
	[130, 80, 'cream', true],
	[27, 79, 'cream', false],
	[88, 81, 'gold', false],
	[144, 83, 'coral', false],
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero jg-night" aria-labelledby="hero-title">
		<span class="jg-stairs" aria-hidden="true"></span>
		<svg class="hero__stars" viewBox="0 0 160 90" preserveAspectRatio="xMidYMid slice" shape-rendering="crispEdges" aria-hidden="true">
			{
				STARS.map(([x, y, color, cross]) =>
					cross ? (
						<path class={`star star--${color}`} d={`M${x} ${y - 1}h1v1h1v1h-1v1h-1v-1h-1v-1h1z`} />
					) : (
						<rect class={`star star--${color}`} x={x} y={y} width="1" height="1" />
					),
				)
			}
		</svg>
		<div class="hero__body">
			<img class="hero__icon jg-pixel" src={icon.src} width="160" height="160" alt="" />
			<div class="hero__text">
				<h1 id="hero-title" class="jg-underline">{SITE_TAGLINE}</h1>
				<p class="hero__sub">1인 게임 개발 · 개발 일지 · 픽셀 아트</p>
				<p class="hero__lead">
					게임을 만드는 과정을 데브로그에 기록합니다. 기획, 아트, 코드, 그리고 혼자 회사를 꾸려가는 이야기까지.
				</p>
				<div class="hero__actions">
					<a class="jg-btn" href="/devlog">데브로그 읽기</a>
					<a class="jg-btn jg-btn--secondary" href="/about">{SITE_TITLE} 소개</a>
				</div>
			</div>
		</div>
		<span class="jg-stairs jg-stairs--up" aria-hidden="true"></span>
	</section>

	<section class="latest" aria-labelledby="latest-title">
		<div class="latest__head">
			<h2 id="latest-title">최근 데브로그</h2>
			<a href="/devlog">전체 보기 →</a>
		</div>
		{
			latestPosts.length > 0 ? (
				<ul class="post-grid">
					{latestPosts.map((post) => (
						<li>
							<PostCard post={post} />
						</li>
					))}
				</ul>
			) : (
				<p class="empty-state">첫 데브로그를 준비하고 있습니다.</p>
			)
		}
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		border-radius: var(--radius-md);
		overflow: hidden;
	}
	.hero > .jg-stairs {
		position: relative;
		z-index: 1;
	}
	.hero__stars {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.star--cream {
		fill: var(--home-cream);
	}
	.star--gold {
		fill: var(--butter-gold);
	}
	.star--coral {
		fill: var(--peach-coral);
	}
	.hero__body {
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--space-10);
		padding: var(--space-16) var(--space-10);
	}
	/* 40×40칸 아이콘: 160px = 칸당 4px, 120px = 칸당 3px. 배너처럼 Night Panel 테두리 */
	.hero__icon {
		flex: none;
		box-sizing: content-box;
		width: 160px;
		height: 160px;
		padding: 8px;
		border-radius: 36px;
		background: var(--night-panel);
	}
	.hero__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		min-width: 0;
	}
	h1 {
		margin: 0;
		font-size: 48px;
		line-height: 52px;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--home-cream);
	}
	.hero__sub {
		margin: 0;
		font-size: 17px;
		line-height: 26px;
		font-weight: 700;
		color: var(--butter-gold);
	}
	.hero__lead {
		margin: 0;
		max-width: 36em;
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-2);
	}

	.latest {
		margin-top: var(--space-16);
	}
	.latest__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: var(--space-6);
	}
	.latest__head h2 {
		margin: 0;
		color: var(--heading);
		font-size: 20px;
		line-height: 28px;
		font-weight: 700;
	}
	.latest__head a {
		font-size: 14px;
		font-weight: 600;
	}

	@media (max-width: 720px) {
		.hero__body {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-6);
			padding: var(--space-10) var(--space-6);
		}
		.hero__icon {
			width: 120px;
			height: 120px;
			padding: 6px;
			border-radius: 28px;
		}
		h1 {
			font-size: 32px;
			line-height: 40px;
		}
	}
</style>
