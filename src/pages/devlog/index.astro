---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('devlog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="데브로그" description="JUSIAI GAMES의 게임 개발 일지">
	<header class="page-head">
		<h1>데브로그</h1>
		<p>게임을 만들며 배운 것, 고민한 것, 만든 것을 기록합니다.{posts.length > 0 && ` 전체 ${posts.length}편.`}</p>
	</header>
	{
		posts.length > 0 ? (
			<ul class="post-grid">
				{posts.map((post) => (
					<li>
						<PostCard post={post} />
					</li>
				))}
			</ul>
		) : (
			<p class="empty-state">첫 데브로그를 준비하고 있습니다.</p>
		)
	}
</BaseLayout>
